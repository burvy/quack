{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quack",
  "identifier": "dev.burvy.quack",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../quack-ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "trunk build",
      "cwd": "../quack-ui"
    },
    "frontendDist": "../quack-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QUACK",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
